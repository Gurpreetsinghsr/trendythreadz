rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the requester an authenticated admin? ────────────────────
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ── Public store reads ──────────────────────────────────────────────────
    match /products/{id}    { allow read: if true; }
    match /collections/{id} { allow read: if true; }
    match /artisans/{id}    { allow read: if true; }
    match /faqs/{id}        { allow read: if true; }
    match /config/{id}      { allow read: if true; }

    // Reviews: public can read approved ones, anyone can submit, admin manages
    match /reviews/{id} {
      allow read:   if resource.data.approved == true || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Orders: anyone can create (checkout flow), owner + admin can read
    match /orders/{id} {
      allow create: if true;
      allow read:   if isAdmin()
                    || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Everything else (admins collection, etc.): admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
